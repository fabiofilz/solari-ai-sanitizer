{
  "name": "solari-ai-sanitizer",
  "version": "0.1.0",
  "description": "Local-first Electron desktop app that sanitizes confidential text before it is shared with an AI assistant, and restores it afterward, using per-workspace encrypted dictionaries.",
  "private": true,
  "main": "dist/main/main/app-lifecycle.js",
  "author": "",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiofilz/solari-ai-sanitizer.git"
  },
  "bugs": {
    "url": "https://github.com/fabiofilz/solari-ai-sanitizer/issues"
  },
  "homepage": "https://github.com/fabiofilz/solari-ai-sanitizer#readme",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "postinstall": "npm run rebuild:native:electron",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "rebuild:native:electron": "electron-rebuild --force --only better-sqlite3",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run rebuild:native:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run rebuild:native:electron && npm run build",
    "test:e2e": "playwright test",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "prepackage": "npm run rebuild:native:electron",
    "package": "npm run build && electron-builder --dir",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "npm run rebuild:native:electron && npm run build:main && npm run build:preload && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -n renderer,electron \"npm:dev:renderer\" \"npm:dev:electron\""
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "monaco-editor": "0.53.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "overrides": {
    "vite": "8.1.4"
  },
  "build": {
    "appId": "com.solari.ai-sanitizer",
    "productName": "Solari AI Sanitizer",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "dir"
    }
  }
}
