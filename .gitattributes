# Force LF line endings on checkout for all text files, regardless of the
# checking-out machine's core.autocrlf setting. Prettier's default endOfLine
# is "lf" — without this, a Windows CI runner with core.autocrlf=true
# converts every committed LF file to CRLF on checkout, which then fails
# `prettier --check .` across the whole tree (verified: this is a real
# failure mode, not a theoretical one).
* text=auto eol=lf
